# GEMINI_API_KEY: Optional for AI features (not required for core MAA accounting).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (must be 3000 in AI Studio preview)
PORT=3000

# ==========================================================
# Meta WhatsApp Business Cloud API (Server-Side Only Secrets)
# NEVER expose WHATSAPP_ACCESS_TOKEN or WHATSAPP_APP_SECRET in frontend code!
# ==========================================================
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="maa_puja_webhook_verify_token"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_APP_SECRET=""

# ==========================================================
# Committee Admin Portal Credentials (Server-Side Only)
# Verified via POST /api/auth/admin-login
# ==========================================================
ADMIN_LOGIN_ID="Admin"
ADMIN_LOGIN_PASSWORD="MY_ADMIN_PASSWORD"

